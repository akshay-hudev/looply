# Copy to .env (repo root for docker-compose, or backend/.env for local runs).

JWT_SECRET=replace-with-a-long-random-string
# DEMO_MODE=true runs the whole pipeline offline with no model API keys (publishing stays simulated).
DEMO_MODE=false
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Model providers (Agnes is primary; others are fallbacks, tried in order) ---
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-3.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_MODEL=agnes-video-2.5
# Endpoint paths are configurable in case the hackathon docs differ from these defaults.
AGNES_CHAT_PATH=/chat/completions
AGNES_IMAGE_PATH=/images/generations
AGNES_VIDEO_PATH=/videos
AGNES_VIDEO_STATUS_PATH=/agnesapi

OPENAI_API_KEY=
GEMINI_API_KEY=
TEXT_PROVIDERS=agnes,openai,gemini
IMAGE_PROVIDERS=agnes,openai
VIDEO_PROVIDERS=agnes
MODEL_REQUESTS_PER_MINUTE=60

# --- Locality ---
LOCALITY_PROVIDER=osm
GOOGLE_PLACES_API_KEY=

# --- Speech (STT/TTS are separate from Agnes) ---
STT_PROVIDER=openai
STT_API_KEY=
BHASHINI_API_KEY=
BHASHINI_URL=

# --- Social platforms (OAuth apps you register with each platform) ---
META_APP_ID=
META_APP_SECRET=
# From Instagram → API setup with Instagram login. Leave blank to use META_APP_ID / META_APP_SECRET.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Random string you set when subscribing the WhatsApp webhook; must match the Meta app config.
WHATSAPP_VERIFY_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Instagram/Facebook fetch media from a public URL; point this at a public tunnel/CDN for MinIO.
S3_PUBLIC_ENDPOINT=http://localhost:9000
